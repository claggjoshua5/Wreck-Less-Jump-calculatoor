{
  "expo": {
    "name": "Wreck-Less Jump Calculator",
    "slug": "wreck-less-jump-calculator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-1024.png",
    "scheme": "wreckless",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.joshandheather.wrecklessjumpcalculator",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Tag your jump locations on the map",
        "NSCameraUsageDescription": "Take photos to measure ramp dimensions"
      }
    },
    "android": {
      "package": "com.joshandheather.wrecklessjumpcalculator",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA"
      ],
      "foregroundService": {
        "notificationTitle": "Wreck-Less Tracking",
        "notificationBody": "Tracking speed in background",
        "notificationColor": "#000000"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Tag your jump locations on the map"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Take photos to measure ramp dimensions"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take photos to measure ramp dimensions"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000"
        }
      ],
      "expo-web-browser",
      "@reactvision/react-viro"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
